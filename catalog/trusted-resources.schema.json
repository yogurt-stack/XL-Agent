{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yogurt-stack/XL-Agent/catalog/trusted-resources.schema.json",
  "title": "XL-Agent Trusted Resource Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "catalogVersion",
    "generatedAt",
    "expiresAt",
    "resources"
  ],
  "properties": {
    "$schema": {
      "const": "./trusted-resources.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "publisher",
        "source",
        "homepage",
        "releasePage",
        "sizeMb",
        "license",
        "purpose",
        "recommendation",
        "required",
        "dependsOn",
        "provides",
        "requiresCapabilities",
        "supportedOperatingSystems",
        "supportedArchitectures",
        "sourceTrust",
        "catalogStatus",
        "verification",
        "download"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "releasePage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sizeMb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "python-runtime",
              "code-editor",
              "source-control",
              "node-runtime",
              "powershell-runtime",
              "workspace-template"
            ]
          }
        },
        "requiresCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "supportedOperatingSystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "Windows 11"
          }
        },
        "supportedArchitectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "x64"
          }
        },
        "sourceTrust": {
          "enum": [
            "official",
            "trusted-catalog",
            "trusted-mirror"
          ]
        },
        "catalogStatus": {
          "const": "active"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "download": {
          "$ref": "#/$defs/download"
        },
        "fallbackId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        }
      }
    },
    "capability": {
      "enum": [
        "python-runtime",
        "code-editor",
        "source-control",
        "node-runtime",
        "powershell-runtime",
        "workspace-template"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checksumAlgorithm",
        "checksumSource",
        "checksumSourceUrl",
        "signatureType",
        "signatureEnforcement"
      ],
      "properties": {
        "checksumAlgorithm": {
          "const": "sha256"
        },
        "checksumSource": {
          "enum": [
            "vendor-manifest",
            "github-release-asset-digest",
            "pinned-repository-snapshot"
          ]
        },
        "checksumSourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "signatureType": {
          "enum": [
            "authenticode",
            "upstream-release",
            "none"
          ]
        },
        "expectedPublisher": {
          "type": "string",
          "minLength": 1
        },
        "signatureEnforcement": {
          "enum": [
            "planned",
            "not-applicable"
          ]
        }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "expectedSha256",
        "maxSizeMb",
        "allowedHosts"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "expectedSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "maxSizeMb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "allowedHosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          }
        }
      }
    }
  }
}
