# Main-process provider adapter. P2 currently supports OpenAI-compatible tool calls.
XL_AGENT_LLM_PROVIDER=openai-compatible

# Configure exactly one HTTPS endpoint mode.
XL_AGENT_LLM_ENDPOINT=
# XL_AGENT_LLM_BASE_URL=https://models.example.com/v1

# Model ID accepted by the configured endpoint.
XL_AGENT_LLM_MODEL=

# Secret read only by the Electron main process.
XL_AGENT_LLM_API_KEY=

# Optional GitHub token for higher Repository Search rate limits.
# Public repository search still works when this is empty.
# XL_AGENT_GITHUB_TOKEN=

# Public web research: tavily (default) or a self-hosted searxng instance.
# Secrets remain in Electron Main. Restart the application after changes.
XL_AGENT_SEARCH_PROVIDER=tavily
XL_AGENT_TAVILY_API_KEY=
# For SearXNG, enable search.formats: [html, json] in its settings.yml.
# XL_AGENT_SEARCH_PROVIDER=searxng
# XL_AGENT_SEARXNG_URL=http://127.0.0.1:8080
# Tavily uses Search + Extract; SearXNG uses local read-only HTML extraction.
# General searches never inherit the GitHub token or publish credentials.

# Separate write token used only after an explicit GitHub publish approval.
# It is never replaced by or shared with XL_AGENT_GITHUB_TOKEN.
# XL_AGENT_GITHUB_PUBLISH_TOKEN=

# Optional approval lifetime in milliseconds. Defaults to 30 minutes.
XL_AGENT_APPROVAL_TTL_MS=1800000

# Optional absolute paths. When omitted, Electron uses its userData directory.
# XL_AGENT_TASK_STORE_PATH=/absolute/path/to/agent-tasks.sqlite
# XL_AGENT_WORKSPACE_ROOT=/absolute/path/to/workspaces

# Optional native 迅雷 SDK transport. Keep disabled until the native host and
# platform runtime are built. Never commit the API key.
# XL_AGENT_XUNLEI_ENABLED=1
# XL_AGENT_XUNLEI_APP_ID=your-xunlei-app-id
# XL_AGENT_XUNLEI_API_KEY=your-xunlei-api-key
# XL_AGENT_XUNLEI_HOST_PATH=/absolute/path/to/xunlei-download-host.exe
